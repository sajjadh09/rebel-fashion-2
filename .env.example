# Copy to .env.local (local dev) or add in Vercel → Project → Settings → Environment Variables.
#
# NEVER put secret keys (SUPABASE_SERVICE_ROLE_KEY, PAYSTACK_SECRET_KEY) in NEXT_PUBLIC_* variables:
# anything starting with NEXT_PUBLIC_ is visible in the browser.

# Enables the demo payment route /api/checkout (no real money moves).
# Remove once Paystack is wired up (see BACKEND.md).
MOCK_PAYMENTS=true

# ── Data source ──────────────────────────────────────────────
# mock     -> demo store in the browser (localStorage). Default.
# http     -> REST backend at NEXT_PUBLIC_API_BASE_URL (src/lib/api/http.ts)
# supabase -> src/lib/api/supabase.ts (to be written by the backend developer, see BACKEND.md)
NEXT_PUBLIC_API_MODE=mock

# Legacy switch, still honoured when NEXT_PUBLIC_API_MODE is not set:
# NEXT_PUBLIC_USE_MOCK_API=false  is the same as  NEXT_PUBLIC_API_MODE=http
# NEXT_PUBLIC_USE_MOCK_API=true

# REST backend base URL, no trailing slash. Only used in "http" mode.
# Example: https://api.rebelfashion.ng/api/v1
NEXT_PUBLIC_API_BASE_URL=

# ── Supabase (only for "supabase" mode) ─────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Used in route handlers (seller approval, Paystack webhook). Never expose.
SUPABASE_SERVICE_ROLE_KEY=

# ── Paystack ────────────────────────────────────────────────
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=
# Server-only.
PAYSTACK_SECRET_KEY=
