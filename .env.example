# ─────────────────────────────────────────────────────────────
# Rebel Fashion — environment variables
# Copy to .env.local for local development. On Vercel set them in
# Project → Settings → Environment Variables.
# NEVER put secret keys (e.g. PAYSTACK_SECRET_KEY) in NEXT_PUBLIC_* variables:
# anything starting with NEXT_PUBLIC_ is visible in the browser.
# ─────────────────────────────────────────────────────────────

# Enables the demo payment route /api/checkout (no real money moves).
MOCK_PAYMENTS=true

# true (default)  -> use demo data stored in the visitor's browser (src/lib/api/mock.ts)
# false           -> call the real REST backend at NEXT_PUBLIC_API_BASE_URL (src/lib/api/http.ts)
NEXT_PUBLIC_USE_MOCK_API=true

# Base URL of the real backend, no trailing slash. Only used when NEXT_PUBLIC_USE_MOCK_API=false.
# Examples: https://api.rebelfashion.ng/api/v1   or   /api/v1 (route handlers in this app)
NEXT_PUBLIC_API_BASE_URL=
